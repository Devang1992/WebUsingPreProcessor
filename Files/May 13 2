Use this version:

@Bean
public StreamsBuilderFactoryBeanConfigurer streamsBuilderFactoryBeanCustomizer(
        @Autowired(required = false) KafkaStreamsTracing kafkaStreamsTracing,
        DependencyInjector context
) {
    return factoryBean -> {
        Properties existingProperties = factoryBean.getStreamsConfiguration();

        Properties updatedProperties = new Properties();

        if (existingProperties != null) {
            updatedProperties.putAll(existingProperties);
        }

        // Main key
        updatedProperties.put(DependencyInjector.CONTEXT_KEY, context);

        // Producer interceptor key path
        updatedProperties.put(
                StreamsConfig.producerPrefix(DependencyInjector.CONTEXT_KEY),
                context
        );

        // Consumer interceptor key path
        updatedProperties.put(
                StreamsConfig.consumerPrefix(DependencyInjector.CONTEXT_KEY),
                context
        );

        factoryBean.setStreamsConfiguration(updatedProperties);

        factoryBean.setKafkaStreamsCustomizer(kafkaStreams -> {
            kafkaStreams.setUncaughtExceptionHandler(
                    new CustomUncaughtExceptionHandler()
            );
        });

        if (kafkaStreamsTracing != null) {
            factoryBean.setClientSupplier(kafkaStreamsTracing.kafkaClientSupplier());
        }
    };
}


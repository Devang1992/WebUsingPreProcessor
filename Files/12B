package com.example.merger.config;

import lombok.Data;
import java.util.List;

/**
 * Maps to merge-config.json.
 * Add entry in JSON + new .jsonata = new merge type. No Java changes.
 */
@Data
public class MergeConfig {

    private List<MergeDefinition> merges;

    @Data
    public static class MergeDefinition {
        /** Unique ID — must match MergeRequest.mergeId */
        private String  id;
        private String  description;
        /** Filename under src/main/resources/jsonata/ */
        private String  expressionFile;
        private boolean enabled;
    }
}


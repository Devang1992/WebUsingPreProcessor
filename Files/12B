package com.example.merger.config;

import com.dashjoin.jsonata.Jsonata;
import com.fasterxml.jackson.databind.ObjectMapper;
import jakarta.annotation.PostConstruct;
import lombok.Getter;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.core.io.Resource;
import org.springframework.core.io.ResourceLoader;
import org.springframework.stereotype.Component;

import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.util.HashMap;
import java.util.Map;

@Slf4j
@Component
@RequiredArgsConstructor
public class MergeConfigLoader {

    private static final String CONFIG_PATH    = "classpath:jsonata/merge-config.json";
    private static final String JSONATA_PREFIX = "classpath:jsonata/";

    private final ResourceLoader resourceLoader;
    private final ObjectMapper   objectMapper;

    /** mergeId -> pre-compiled Jsonata expression */
    @Getter
    private final Map<String, Jsonata> compiledExpressions = new HashMap<>();

    @PostConstruct
    public void load() throws IOException {
        MergeConfig config = objectMapper.readValue(
            resourceLoader.getResource(CONFIG_PATH).getInputStream(),
            MergeConfig.class
        );

        for (MergeConfig.MergeDefinition def : config.getMerges()) {
            if (!def.isEnabled()) { log.info("Skipping disabled: {}", def.getId()); continue; }

            Resource res = resourceLoader.getResource(JSONATA_PREFIX + def.getExpressionFile());
            if (!res.exists()) { log.warn("Missing file for '{}': {}", def.getId(), def.getExpressionFile()); continue; }

            String raw     = new String(res.getInputStream().readAllBytes(), StandardCharsets.UTF_8);
            String cleaned = raw.replaceAll("/\*[\s\S]*?\*/", "").trim();

            compiledExpressions.put(def.getId(), Jsonata.jsonata(cleaned));
            log.info("Loaded: '{}' <- {}", def.getId(), def.getExpressionFile());
        }
        log.info("JSONata loader ready — {} expression(s)", compiledExpressions.size());
    }

    public Jsonata getExpression(String mergeId) {
        Jsonata expr = compiledExpressions.get(mergeId);
        if (expr == null) throw new IllegalArgumentException(
            "No expression for mergeId: '" + mergeId + "'. Check merge-config.json.");
        return expr;
    }
}




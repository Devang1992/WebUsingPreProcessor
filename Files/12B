package com.example.merger.service;

import com.dashjoin.jsonata.Jsonata;
import com.example.merger.config.MergeConfigLoader;
import com.example.merger.model.MergeRequest;
import com.example.merger.model.MergeResponse;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.util.LinkedHashMap;
import java.util.Map;

@Slf4j
@Service
@RequiredArgsConstructor
public class JsonataMergeService {

    private final MergeConfigLoader configLoader;
    private final ObjectMapper      objectMapper;

    public MergeResponse merge(MergeRequest request) {
        log.debug("Starting merge for id='{}'", request.getMergeId());

        Jsonata expression = configLoader.getExpression(request.getMergeId());

        // JSONata-java needs plain Maps, not JsonNode
        Map<String, Object> bindings = new LinkedHashMap<>();
        bindings.put("p1", toPlainObject(request.getPayload1())); // -> $p1
        bindings.put("p2", toPlainObject(request.getPayload2())); // -> $p2

        if (request.getBindings() != null) bindings.putAll(request.getBindings());

        try {
            bindings.forEach((key, value) -> {
                try { expression.assign(key, value); }
                catch (Exception e) {
                    throw new RuntimeException("Failed to bind $" + key, e);
                }
            });

            Object    raw    = expression.evaluate(null); // null = no root context
            JsonNode  result = objectMapper.valueToTree(raw);

            log.debug("Merge complete for id='{}'", request.getMergeId());
            return new MergeResponse(request.getMergeId(), result);

        } catch (Exception e) {
            log.error("Evaluation failed for '{}': {}", request.getMergeId(), e.getMessage(), e);
            throw new RuntimeException("Merge evaluation failed: " + e.getMessage(), e);
        }
    }

    private Object toPlainObject(JsonNode node) {
        return node == null ? null : objectMapper.convertValue(node, Object.class);
    }
}



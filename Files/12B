package com.example.merger;

import com.example.merger.model.MergeRequest;
import com.example.merger.model.MergeResponse;
import com.example.merger.service.JsonataMergeService;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;

import static org.assertj.core.api.Assertions.assertThat;

@SpringBootTest
class CustomerHvpMergeTest {

    @Autowired JsonataMergeService mergeService;
    @Autowired ObjectMapper        objectMapper;

    static final String P1_BILL = """
        {
          "customer": {
            "customerId": "CUST-0042", "customerType": "RETAIL",
            "account": {
              "accountId": "ACC-9981", "status": "ACTIVE",
              "routingConfig": { "indicator": "BILL", "configVersion": "v2" },
              "profile": {
                "profileId": "PROF-771", "tier": "GOLD",
                "HVP": {
                  "name": "Jane Doe", "referenceData": "OLD-REF",
                  "contactDetails": { "phone": "555-1234", "preferredContact": "PHONE" }
                }
              },
              "billingProfile": { "billingId":"BILL-441","rateCode":"STALE-RATE","paymentMethod":"DIRECT_DEBIT","currency":"GBP" },
              "pricingProfile": { "pricingId":"PRICE-99","priceCode":"TIER-A","discount":0.10 },
              "riskProfile":    { "riskId":"RISK-77","riskIndicator":"LOW","reviewDate":"2025-06-01" }
            },
            "metadata": { "createdBy": "system", "flags": ["VERIFIED","OPTED_IN"] }
          }
        }""";

    static final String P2 = """
        {
          "customer": {
            "customerId": null, "customerType": null,
            "account": {
              "accountId": null, "status": null, "routingConfig": null,
              "profile": {
                "profileId": null, "tier": null,
                "HVP": {
                  "address": "10 High Street, London, EC1A 1BB",
                  "referenceData": "NEW-REF-XYZ",
                  "contactDetails": { "email": "jane.doe@example.com" }
                }
              },
              "billingProfile": null, "pricingProfile": null, "riskProfile": null
            },
            "metadata": null
          }
        }""";

    @Test
    void indicatorBill_writesReferenceDataToBillingRateCode() throws Exception {
        JsonNode r = merge(P1_BILL, P2);
        assertThat(r.at("/customer/account/billingProfile/rateCode").asText()).isEqualTo("NEW-REF-XYZ");
        assertThat(r.at("/customer/account/billingProfile/paymentMethod").asText()).isEqualTo("DIRECT_DEBIT");
        assertThat(r.at("/customer/account/pricingProfile/priceCode").asText()).isEqualTo("TIER-A");
        assertThat(r.at("/customer/account/riskProfile/riskIndicator").asText()).isEqualTo("LOW");
    }

    @Test
    void indicatorPrice_writesReferenceDataToPricingPriceCode() throws Exception {
        JsonNode r = merge(P1_BILL.replace("\"BILL\"", "\"PRICE\""), P2);
        assertThat(r.at("/customer/account/pricingProfile/priceCode").asText()).isEqualTo("NEW-REF-XYZ");
        assertThat(r.at("/customer/account/billingProfile/rateCode").asText()).isEqualTo("STALE-RATE");
    }

    @Test
    void indicatorRisk_writesReferenceDataToRiskIndicator() throws Exception {
        JsonNode r = merge(P1_BILL.replace("\"BILL\"", "\"RISK\""), P2);
        assertThat(r.at("/customer/account/riskProfile/riskIndicator").asText()).isEqualTo("NEW-REF-XYZ");
        assertThat(r.at("/customer/account/billingProfile/rateCode").asText()).isEqualTo("STALE-RATE");
    }

    @Test
    void hvp_flatFieldsMergedCorrectly() throws Exception {
        JsonNode hvp = merge(P1_BILL, P2).at("/customer/account/profile/HVP");
        assertThat(hvp.path("name").asText()).isEqualTo("Jane Doe");
        assertThat(hvp.path("address").asText()).isEqualTo("10 High Street, London, EC1A 1BB");
        assertThat(hvp.path("referenceData").asText()).isEqualTo("NEW-REF-XYZ");
    }

    @Test
    void hvp_contactDetailsDeepMerged() throws Exception {
        JsonNode cd = merge(P1_BILL, P2).at("/customer/account/profile/HVP/contactDetails");
        assertThat(cd.path("phone").asText()).isEqualTo("555-1234");
        assertThat(cd.path("preferredContact").asText()).isEqualTo("PHONE");
        assertThat(cd.path("email").asText()).isEqualTo("jane.doe@example.com");
    }

    @Test
    void p2NullsOutsideHvp_neverOverwriteP1() throws Exception {
        JsonNode r = merge(P1_BILL, P2);
        assertThat(r.at("/customer/customerId").asText()).isEqualTo("CUST-0042");
        assertThat(r.at("/customer/account/routingConfig/configVersion").asText()).isEqualTo("v2");
        assertThat(r.at("/customer/account/profile/tier").asText()).isEqualTo("GOLD");
        assertThat(r.at("/customer/metadata/flags").get(0).asText()).isEqualTo("VERIFIED");
    }

    private JsonNode merge(String p1, String p2) throws Exception {
        MergeRequest req = new MergeRequest();
        req.setMergeId("customer-hvp-merge");
        req.setPayload1(objectMapper.readTree(p1));
        req.setPayload2(objectMapper.readTree(p2));
        return mergeService.merge(req).getResult();
    }
}




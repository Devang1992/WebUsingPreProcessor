$hvpMerged := $merge([
    $p1.customer.account.profile.HVP,
    $p2.customer.account.profile.HVP,
    {
        "contactDetails": $merge([
            $p1.customer.account.profile.HVP.contactDetails,
            $p2.customer.account.profile.HVP.contactDetails
        ])
    }
]);

$referenceData := $hvpMerged.referenceData;

$routingKey := $p1.customer.account.routingConfig.indicator;

$routingMap := {
    "BILL":   { "section": "billingProfile",  "field": "rateCode"      },
    "PRICE":  { "section": "pricingProfile",  "field": "priceCode"     },
    "RISK":   { "section": "riskProfile",     "field": "riskIndicator" }
};

$route := $lookup($routingMap, $routingKey);

$merge([
    $p1,
    {
        "customer": $merge([
            $p1.customer,
            {
                "account": $merge([
                    $p1.customer.account,
                    {
                        "profile": $merge([
                            $p1.customer.account.profile,
                            { "HVP": $hvpMerged }
                        ]),
                        "billingProfile": $merge([
                            $p1.customer.account.billingProfile,
                            $route.section = "billingProfile"
                                ? { ($route.field): $referenceData }
                                : {}
                        ]),
                        "pricingProfile": $merge([
                            $p1.customer.account.pricingProfile,
                            $route.section = "pricingProfile"
                                ? { ($route.field): $referenceData }
                                : {}
                        ]),
                        "riskProfile": $merge([
                            $p1.customer.account.riskProfile,
                            $route.section = "riskProfile"
                                ? { ($route.field): $referenceData }
                                : {}
                        ])
                    }
                ])
            }
        ])
    }
])


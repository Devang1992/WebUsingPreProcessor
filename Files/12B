package com.example.merger.model;

import com.fasterxml.jackson.databind.JsonNode;
import lombok.Data;
import java.util.Map;

@Data
public class MergeRequest {

    /** Must match an 'id' in merge-config.json */
    private String mergeId;

    /** Full payload — base for everything outside HVP */
    private JsonNode payload1;

    /**
     * Same schema as payload1 but only HVP is populated.
     * All null/empty fields outside HVP are ignored.
     */
    private JsonNode payload2;

    /**
     * Optional extra variables injected into the JSONata expression.
     * E.g. { "currencyMultiplier": 1.32 } -> $currencyMultiplier in .jsonata
     */
    private Map<String, Object> bindings;
}


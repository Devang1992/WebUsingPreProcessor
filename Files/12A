@Slf4j
@Component
@RequiredArgsConstructor
public class MergeConfigLoader {

    private static final String CONFIG_PATH    = "classpath:jsonata/merge-config.json";
    private static final String JSONATA_PREFIX = "classpath:jsonata/";

    private final ResourceLoader resourceLoader;
    private final ObjectMapper   objectMapper;

    /** mergeId → compiled Jsonata expression (pre-compiled at startup) */
    @Getter
    private final Map<String, Jsonata> compiledExpressions = new HashMap<>();

    @PostConstruct
    public void load() throws IOException {
        Resource configResource = resourceLoader.getResource(CONFIG_PATH);
        MergeConfig config = objectMapper.readValue(
            configResource.getInputStream(), MergeConfig.class);

        for (MergeConfig.MergeDefinition def : config.getMerges()) {
            if (!def.isEnabled()) { continue; }

            Resource exprResource = resourceLoader.getResource(
                JSONATA_PREFIX + def.getExpressionFile());

            String expression = new String(
                exprResource.getInputStream().readAllBytes(), StandardCharsets.UTF_8);

            // Strip block comments — JSONata parser doesn't support /* */
            String cleaned = expression.replaceAll("/\\*[\\s\\S]*?\\*/", "").trim();

            compiledExpressions.put(def.getId(), Jsonata.jsonata(cleaned));
            log.info("Loaded: '{}' ({})", def.getId(), def.getExpressionFile());
        }
    }

    public Jsonata getExpression(String mergeId) {
        Jsonata expr = compiledExpressions.get(mergeId);
        if (expr == null) throw new IllegalArgumentException(
            "No merge expression for id: '" + mergeId + "'");
        return expr;
    }
}


src/main/java/.../service/JsonataMergeService.java

@Slf4j
@Service
@RequiredArgsConstructor
public class JsonataMergeService {

    private final MergeConfigLoader configLoader;
    private final ObjectMapper      objectMapper;

    public JsonNode merge(MergeRequest request) {
        Jsonata expression = configLoader.getExpression(request.getMergeId());

        // JSONata-java needs plain Maps, not JsonNode
        Object p1 = toPlainObject(request.getPayload1());
        Object p2 = toPlainObject(request.getPayload2());

        // $p1 and $p2 are always available in every .jsonata file
        Map<String, Object> bindings = new LinkedHashMap<>();
        bindings.put("p1", p1);
        bindings.put("p2", p2);

        // Caller can pass extra vars e.g. { "currencyMultiplier": 1.32 }
        // These become $currencyMultiplier inside the .jsonata expression
        if (request.getBindings() != null) {
            bindings.putAll(request.getBindings());
        }

        try {
            bindings.forEach((k, v) -> {
                try { expression.assign(k, v); }
                catch (Exception e) {
                    throw new RuntimeException("Failed to bind $" + k, e);
                }
            });

            // null root context — expressions use $p1/$p2 bindings
            Object result = expression.evaluate(null);
            return objectMapper.valueToTree(result);

        } catch (Exception e) {
            log.error("Evaluation failed for '{}': {}", request.getMergeId(), e.getMessage());
            throw new RuntimeException("Merge evaluation failed", e);
        }
    }

    private Object toPlainObject(JsonNode node) {
        if (node == null) return null;
        return objectMapper.convertValue(node, Object.class);
    }
}


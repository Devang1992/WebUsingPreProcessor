/**
 * order-merge.jsonata  —  your "XQuery logic file"
 *
 * Merges two payloads 4 levels deep:
 *   ROOT > ORG > REGION > ORDERS
 *
 * Status field transformation:
 *   PENDING   → AWAITING_PROCESSING
 *   SHIPPED   → IN_TRANSIT
 *   DELIVERED → COMPLETED
 *   other     → UNKNOWN_<uppercased>
 */

/* helper: map status values */
$statusMap := function($raw) {
  $raw = "PENDING"   ? "AWAITING_PROCESSING" :
  $raw = "SHIPPED"   ? "IN_TRANSIT"          :
  $raw = "DELIVERED" ? "COMPLETED"           :
  "UNKNOWN_" & $uppercase($raw)
};

/* helper: merge two ORDERS arrays, deduplicate by orderId.
   payload2 wins on conflict — swap $append order to flip that. */
$mergeOrders := function($arr1, $arr2) {(
  $combined := $append($arr1, $arr2);
  $ids      := $distinct($combined.orderId);
  $ids.(
    $id      := $;
    $matches := $combined[orderId = $id];
    $order   := $matches[$count($matches) - 1];
    $merge([$order, { "status": $statusMap($order.status) }])
  )
)};

/* main: rebuild full 4-level structure around merged array */
{
  "ROOT": {
    "ORG": {
      "REGION": {
        "ORDERS": $mergeOrders(
          $p1.ROOT.ORG.REGION.ORDERS,
          $p2.ROOT.ORG.REGION.ORDERS
        )
      },
      "regionCode":  $p2.ROOT.ORG.REGION.regionCode  != null
                       ? $p2.ROOT.ORG.REGION.regionCode
                       : $p1.ROOT.ORG.REGION.regionCode,
      "regionLabel": $p2.ROOT.ORG.REGION.regionLabel != null
                       ? $p2.ROOT.ORG.REGION.regionLabel
                       : $p1.ROOT.ORG.REGION.regionLabel
    },
    "orgId":   $p1.ROOT.ORG.orgId,
    "orgName": $p2.ROOT.ORG.orgName != null
                 ? $p2.ROOT.ORG.orgName
                 : $p1.ROOT.ORG.orgName
  },
  "schemaVersion": $p1.ROOT.schemaVersion,
  "generatedAt":   $now()
}


@SpringBootTest
class JsonataMergeServiceTest {

    @Autowired JsonataMergeService mergeService;
    @Autowired ObjectMapper objectMapper;

    static final String PAYLOAD_1 = """
        {
          "ROOT": { "schemaVersion": "1.0",
            "ORG": { "orgId": "ORG-001", "orgName": "ACME Corp",
              "REGION": { "regionCode": "NA",
                "ORDERS": [
                  { "orderId": "ORD-123", "amount": 99.99,  "status": "PENDING" },
                  { "orderId": "ORD-456", "amount": 250.00, "status": "SHIPPED" }
                ]
              }
            }
          }
        }""";

    static final String PAYLOAD_2 = """
        {
          "ROOT": { "schemaVersion": "1.0",
            "ORG": { "orgId": "ORG-001", "orgName": "ACME Corp",
              "REGION": { "regionCode": "NA",
                "ORDERS": [
                  { "orderId": "ORD-789", "amount": 45.00,  "status": "DELIVERED" },
                  { "orderId": "ORD-456", "amount": 260.00, "status": "SHIPPED"   }
                ]
              }
            }
          }
        }""";

    @Test
    void mergesCombinesUniqueOrders() throws Exception {
        MergeRequest req = new MergeRequest();
        req.setMergeId("order-merge");
        req.setPayload1(objectMapper.readTree(PAYLOAD_1));
        req.setPayload2(objectMapper.readTree(PAYLOAD_2));

        JsonNode result  = mergeService.merge(req);
        JsonNode orders  = result.at("/ROOT/ORG/REGION/ORDERS");

        // 3 unique orders: ORD-123, ORD-456 (deduplicated), ORD-789
        assertThat(orders.size()).isEqualTo(3);
    }

    @Test
    void statusFieldIsTransformed() throws Exception {
        MergeRequest req = new MergeRequest();
        req.setMergeId("order-merge");
        req.setPayload1(objectMapper.readTree(PAYLOAD_1));
        req.setPayload2(objectMapper.readTree(PAYLOAD_2));

        JsonNode orders = mergeService.merge(req).at("/ROOT/ORG/REGION/ORDERS");

        assertThat(findOrder(orders,"ORD-123").get("status").asText())
            .isEqualTo("AWAITING_PROCESSING");   // PENDING →
        assertThat(findOrder(orders,"ORD-456").get("status").asText())
            .isEqualTo("IN_TRANSIT");            // SHIPPED →
        assertThat(findOrder(orders,"ORD-789").get("status").asText())
            .isEqualTo("COMPLETED");             // DELIVERED →
    }

    private JsonNode findOrder(JsonNode orders, String id) {
        for (JsonNode o : orders)
            if (id.equals(o.path("orderId").asText())) return o;
        throw new AssertionError("Order not found: " + id);
    }
}

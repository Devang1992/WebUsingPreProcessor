@Data
public class MergeRequest {
    /** Must match an 'id' in merge-config.json */
    private String mergeId;

    private JsonNode payload1;
    private JsonNode payload2;

    /**
     * Optional runtime bindings passed into the JSONata expression.
     * e.g. { "currencyMultiplier": 1.32 }
     * → accessible as $currencyMultiplier inside the .jsonata file
     */
    private Map<String, Object> bindings;
}


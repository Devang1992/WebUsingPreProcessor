private static final int LINE_LENGTH = 134;
    private static final String CRLF = "\r\n";

    public static String formatBanner(String banner) {
        if (banner == null || banner.isEmpty()) {
            return "";
        }

        StringBuilder formatted = new StringBuilder();

        String[] lines = banner.split("\\r?\\n");

        for (String line : lines) {
            if (line == null || line.trim().isEmpty()) {
                continue; // remove blank lines
            }

            String processedLine = padOrTrim(line);

            formatted.append(processedLine).append(CRLF);
        }

        return formatted.toString();
    }

    private static String padOrTrim(String line) {
        if (line.length() > LINE_LENGTH) {
            // trim if longer
            return line.substring(0, LINE_LENGTH);
        }

        // pad if shorter
        return String.format("%-" + LINE_LENGTH + "s", line);
    }



public static String removeTrailingBlankLine(String input) {
    if (input == null || input.isEmpty()) {
        return input;
    }

    // Normalize for safety
    String normalized = input.replace("\r", "");

    String[] lines = normalized.split("\n", -1);

    // If last line is blank → remove it
    if (lines.length > 0 && lines[lines.length - 1].trim().isEmpty()) {
        return String.join("\n", java.util.Arrays.copyOf(lines, lines.length - 1));
    }

    return input;
}

Best structure

Do it in 2 layers:

1. pants-mapper.xq

Keep this as the main module only

parses JSON
detects message type
dispatches to pacs004 / 008 / 009
2. Create a new shared library module

Something like:

pants-common.xq

This should contain:

normalizeOrNull
safe-array-item
common field builders
maybe reusable sub-map builders like customer/posting/creditor if same across files

This is better than putting helper functions inside pants-mapper.xq, because imported library modules usually cannot import from the main module. Main module is entrypoint, not shared utility.

So:

pants-mapper.xq = dispatcher
pants-common.xq = shared reusable code
tddm-pacs004-pdm-public.xq = pacs004 specific mapping
tddm-pacs008-pdm-public.xq = pacs008 specific mapping
tddm-pacs009-pdm-public.xq = pacs009 specific mapping
Why not keep common functions in pants-mapper.xq?

Because your pacs files are imported by pants-mapper.xq.

They generally should not depend back on the main module. That creates the wrong direction of dependency.

Think of it like Java:

pants-mapper.xq = Main.java
pants-common.xq = CommonUtils.java
tddm-pacs004...xq = Pacs004Mapper.java

You would not put utility methods inside Main.java and expect all mapper classes to import from it.

Recommended design
File 1: pants-common.xq
xquery version "3.1";

module namespace common = "http://www.td.com/pants-common";

declare function common:normalizeOrNull($value as item()*) as item()? {
  if (exists($value) and normalize-space(string($value)) != "") then
    normalize-space(string($value))
  else
    ()
};

declare function common:safe-array-item($arr as item()*, $idx as xs:integer) as item()? {
  if (empty($arr)) then
    ()
  else if ($arr instance of array(*)) then
    if ($idx ge 1 and $idx le array:size($arr)) then
      $arr?($idx)
    else
      ()
  else if ($idx = 1) then
    $arr
  else
    ()
};

declare function common:customer($hvp as item()*) as map(*) {
  map {
    "name": common:normalizeOrNull($hvp?Customer?Name),
    "address1": common:normalizeOrNull($hvp?Customer?Address1),
    "address2": common:normalizeOrNull($hvp?Customer?Address2),
    "address3": common:normalizeOrNull($hvp?Customer?Address3),
    "city": common:normalizeOrNull($hvp?Customer?City),
    "state": common:normalizeOrNull($hvp?Customer?State),
    "zip": common:normalizeOrNull($hvp?Customer?Zip)
  }
};

declare function common:posting($hvp as item()*) as map(*) {
  map {
    "accountNumber": common:normalizeOrNull($hvp?DebitAccount?AccNb),
    "creditAccountNumber": common:normalizeOrNull($hvp?CreditAccount?AccNb),
    "debitFees": common:normalizeOrNull($hvp?Fee?DbFee),
    "creditFees": common:normalizeOrNull($hvp?Fee?CrFee)
  }
};

declare function common:baseFields($jsonInput as map(*), $type as xs:string) as map(*) {
  let $hvp := $jsonInput?TDDMessage?TDDMExtended?HVP
  return map {
    "type": $type,
    "direction": common:normalizeOrNull($hvp?Direction),
    "mid": common:normalizeOrNull($hvp?Id?MID),
    "status": common:normalizeOrNull($hvp?Status),
    "adviceCode": common:normalizeOrNull($hvp?AdviceCode),
    "prodCode": common:normalizeOrNull($hvp?ProdCode),
    "customer": common:customer($hvp),
    "posting": common:posting($hvp),
    "createDate": common:normalizeOrNull($hvp?CreateDate)
  }
};

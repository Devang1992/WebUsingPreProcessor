@Test
void shouldConvertUtcToEastern_whenSystemTimezoneIsLondon() {
    TimeZone original = TimeZone.getDefault();

    try {
        // Simulate London server
        TimeZone.setDefault(TimeZone.getTimeZone("Europe/London"));

        JobInformationLogger logger =
                new JobInformationLogger(mock(BatchFileLocations.class));

        // UTC input
        LocalDateTime utcTime = LocalDateTime.of(2025, 9, 1, 3, 0, 0);

        String result = logger.formatAsEasternTimestamp(utcTime);

        // Toronto (EDT, UTC-4)
        assertEquals("2025-08-31T23:00:00 EDT", result);

    } finally {
        TimeZone.setDefault(original);
    }
}

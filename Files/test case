@Test
void shouldConvertUtc3AmToTorontoRegardlessOfMachineTimezone() {
    TimeZone original = TimeZone.getDefault();
    try {
        TimeZone.setDefault(TimeZone.getTimeZone("America/Los_Angeles"));

        JobInformationLogger logger =
                new JobInformationLogger(mock(BatchFileLocations.class));

        String result = logger.formatAsEasternTimestamp(
                LocalDateTime.of(2025, 9, 1, 3, 0, 0)
        );

        assertEquals("2025-08-31T23:00:00 EDT", result);
    } finally {
        TimeZone.setDefault(original);
    }
}

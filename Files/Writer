7. Optional tasklet just to print file info after step

This is nice for local verification before SFTP.

LocalFileInfoTasklet.java
package com.td.payments.pants.mailservice.job.component;

import com.td.payments.pants.mailservice.job.writer.LocalFlatFileItemWriter;
import lombok.extern.slf4j.Slf4j;
import org.springframework.batch.core.StepContribution;
import org.springframework.batch.core.scope.context.ChunkContext;
import org.springframework.batch.core.step.tasklet.Tasklet;
import org.springframework.batch.repeat.RepeatStatus;
import org.springframework.stereotype.Component;

import java.nio.file.Files;
import java.nio.file.Path;

@Slf4j
@Component
public class LocalFileInfoTasklet implements Tasklet {

    @Override
    public RepeatStatus execute(StepContribution contribution, ChunkContext chunkContext) throws Exception {
        String filePath = contribution.getStepExecution()
                .getJobExecution()
                .getExecutionContext()
                .getString(LocalFlatFileItemWriter.OUTPUT_FILE_PATH, null);

        if (filePath == null) {
            log.warn("No output file path found in execution context");
            return RepeatStatus.FINISHED;
        }

        Path path = Path.of(filePath);
        if (Files.exists(path)) {
            long size = Files.size(path);
            log.info("Local output file created: {}", path.toAbsolutePath());
            log.info("Local output file size: {} bytes", size);
        } else {
            log.warn("Output file does not exist: {}", filePath);
        }

        return RepeatStatus.FINISHED;
    }
}

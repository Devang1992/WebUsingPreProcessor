2. Refactor generator implementation

This keeps your current logic, but instead of returning one giant String, it writes page-by-page.

BatchTemplateGeneratorImp.java
package com.td.payments.pants.mailservice.job.transformer;

import lombok.RequiredArgsConstructor;
import org.springframework.lang.Nullable;
import org.springframework.stereotype.Component;
import org.springframework.util.StringUtils;

import java.io.IOException;
import java.io.Writer;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.regex.Pattern;

@Component
@RequiredArgsConstructor
public class BatchTemplateGeneratorImp implements BatchTemplateGenerator {

    private static final int PAGE_LINES = 66;
    private static final int CONTENT_LAST_LINE = 62;
    private static final int LINE_ID_LINE = 1;
    private static final int FIRST_PAGE_HASH_LINE = 2;
    private static final int FIRST_PAGE_ADDRESS_START = 17;
    private static final int NEXT_PAGE_ADDRESS_START = 8;
    private static final int PAGE_NUMBER_LINE = 66;
    private static final int LINE_LENGTH = 133;
    private static final int MAX_CONTENT_PER_LINE = 75;

    private static final String WRAP_INDEX_MARKER = "Wrap_Index";
    private static final String EOL = "\r\n";
    private static final String END_ADDRESS_MARKER = "[END_ADDRESS]";
    private static final String SKIP_LINE_MARKER = "_SKIP_LINE_";
    private static final String BLANK_LINE = " ".repeat(LINE_LENGTH);

    @Override
    public void writeTemplate(String message, Writer writer) throws IOException {
        SplitResult result = extractLines(message);
        List<String> contentLines = result.contentLines();
        List<String> addressBlock = result.addressBlock();

        boolean firstPage = true;
        int idx = 0;
        int pageCounter = 1;

        while (idx < contentLines.size()) {
            List<String> page = blankPage();

            addHeader(page, firstPage);
            int contentStart = addAddress(page, addressBlock, firstPage);
            idx = addContent(page, contentLines, idx, contentStart);
            addPageNumber(page, pageCounter++);

            writePage(page, writer);
            firstPage = false;
        }
    }

    private void writePage(List<String> page, Writer writer) throws IOException {
        for (String line : page) {
            writer.write(line);
            writer.write(EOL);
        }
    }

    private void addHeader(List<String> page, boolean firstPage) {
        page.set(LINE_ID_LINE - 1, pad("1"));
        if (firstPage) {
            page.set(FIRST_PAGE_HASH_LINE - 1, pad("##"));
        }
    }

    private int addAddress(List<String> page, List<String> addressBlock, boolean firstPage) {
        int addressStart = firstPage ? FIRST_PAGE_ADDRESS_START : NEXT_PAGE_ADDRESS_START;

        if (firstPage) {
            int singleLine = addressStart;
            for (String addr : addressBlock) {
                if (singleLine > CONTENT_LAST_LINE) {
                    break;
                }
                page.set(singleLine - 1, pad(addr));
                singleLine++;
            }
            return addressStart + addressBlock.size();
        }

        return addressStart;
    }

    private int addContent(List<String> page, List<String> contentLines, int idx, int contentStart) {
        int linePtr = contentStart;
        while (idx < contentLines.size() && linePtr <= CONTENT_LAST_LINE) {
            page.set(linePtr - 1, pad(contentLines.get(idx++)));
            linePtr++;
        }
        return idx;
    }

    private void addPageNumber(List<String> page, int pageCounter) {
        page.set(PAGE_NUMBER_LINE - 1, pad(String.format(" Page %02d", pageCounter)));
    }

    private SplitResult extractLines(String message) {
        List<String> contentLines = new ArrayList<>();
        List<String> addressBlock = new ArrayList<>();

        String[] lines = message.split("\\r?\\n");
        boolean isAddressBlock = true;
        int lineWrapIndentation = 2;

        for (String line : lines) {
            boolean shouldContinue = false;

            int updatedIndentation = updateLineWrapIndentation(line);
            if (updatedIndentation != -1) {
                lineWrapIndentation = updatedIndentation;
                shouldContinue = true;
            }

            if (!shouldContinue) {
                line = processSkipLineMarker(line);
                if (line == null) {
                    shouldContinue = true;
                }
            }

            if (shouldContinue) {
                continue;
            }

            if (StringUtils.hasText(line) && line.contains(END_ADDRESS_MARKER)) {
                processEndAddressMarker(line, addressBlock, contentLines);
                isAddressBlock = false;
            } else if (isAddressBlock) {
                processAddressBlock(line, addressBlock, contentLines);
            } else {
                processContentLine(line, contentLines, lineWrapIndentation);
            }
        }

        return new SplitResult(addressBlock, contentLines);
    }

    private int updateLineWrapIndentation(String line) {
        if (line.contains(WRAP_INDEX_MARKER)) {
            return line.contains("Wrap_Index_CoverPaymentContent") ? 4 : 39;
        }
        return -1;
    }

    @Nullable
    private String processSkipLineMarker(String line) {
        if (line.contains(SKIP_LINE_MARKER)) {
            String processed = line.replace(SKIP_LINE_MARKER, "").replace("\t", "");
            if (processed.isBlank()) {
                return null;
            }
            return processed;
        }
        return line;
    }

    private void processEndAddressMarker(String line, List<String> addressBlock, List<String> contentLines) {
        String processedLine = line.replace(END_ADDRESS_MARKER, "");
        addressBlock.add(processedLine);
        contentLines.add(processedLine);
    }

    private void processAddressBlock(@Nullable String line, List<String> addressBlock, List<String> contentLines) {
        addressBlock.add(line);
        contentLines.add(line);
    }

    private void processContentLine(@Nullable String line, List<String> contentLines, int lineWrapIndentation) {
        if (StringUtils.hasText(line) && line.length() > MAX_CONTENT_PER_LINE) {
            contentLines.addAll(WordWrap.wrapLines(line, MAX_CONTENT_PER_LINE, lineWrapIndentation));
        } else {
            contentLines.add(line);
        }
    }

    private List<String> blankPage() {
        return new ArrayList<>(Collections.nCopies(PAGE_LINES, BLANK_LINE));
    }

    private static String pad(String s) {
        if (s == null) {
            s = "";
        }
        if (s.length() >= LINE_LENGTH) {
            return s.substring(0, LINE_LENGTH);
        }
        return s + BLANK_LINE.substring(s.length());
    }
}

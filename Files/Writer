4. Local file writer for Spring Batch

This writer opens one temp/local file for the step and appends all generated output into it.

LocalFlatFileItemWriter.java
package com.td.payments.pants.mailservice.job.writer;

import com.td.payments.pants.mailservice.job.transformer.BatchTemplateGenerator;
import lombok.extern.slf4j.Slf4j;
import org.springframework.batch.item.Chunk;
import org.springframework.batch.item.ExecutionContext;
import org.springframework.batch.item.ItemStreamException;
import org.springframework.batch.item.ItemStreamWriter;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Profile;
import org.springframework.stereotype.Component;

import java.io.BufferedWriter;
import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;

@Slf4j
@Component
@Profile("itest")
public class LocalFlatFileItemWriter implements ItemStreamWriter<String> {

    public static final String OUTPUT_FILE_PATH = "batch.output.file.path";

    private final BatchTemplateGenerator batchTemplateGenerator;

    @Value("${batch.output.directory:./build/batch-output}")
    private String outputDirectory;

    @Value("${batch.output.file-name:test-output.txt}")
    private String outputFileName;

    private BufferedWriter writer;
    private Path outputFile;

    public LocalFlatFileItemWriter(BatchTemplateGenerator batchTemplateGenerator) {
        this.batchTemplateGenerator = batchTemplateGenerator;
    }

    @Override
    public void open(ExecutionContext executionContext) throws ItemStreamException {
        try {
            Path dir = Path.of(outputDirectory);
            Files.createDirectories(dir);

            outputFile = dir.resolve(outputFileName);

            writer = Files.newBufferedWriter(
                    outputFile,
                    StandardCharsets.UTF_8
            );

            executionContext.putString(OUTPUT_FILE_PATH, outputFile.toAbsolutePath().toString());

            log.info("Opened local batch output file at {}", outputFile.toAbsolutePath());
        } catch (IOException e) {
            throw new ItemStreamException("Failed to open local batch output file", e);
        }
    }

    @Override
    public void write(Chunk<? extends String> chunk) throws Exception {
        for (String item : chunk.getItems()) {
            batchTemplateGenerator.writeTemplate(item, writer);
        }
        writer.flush();
    }

    @Override
    public void update(ExecutionContext executionContext) throws ItemStreamException {
        if (outputFile != null) {
            executionContext.putString(OUTPUT_FILE_PATH, outputFile.toAbsolutePath().toString());
        }
    }

    @Override
    public void close() throws ItemStreamException {
        if (writer != null) {
            try {
                writer.close();
                log.info("Closed local batch output file at {}", outputFile.toAbsolutePath());
            } catch (IOException e) {
                throw new ItemStreamException("Failed to close local batch output file", e);
            }
        }
    }
}
5. Batch config for local test

You likely already have a step config. For local testing, just swap the writer bean.

Example step
@Bean
@Profile("itest")
public Step localFileWriteStep(JobRepository jobRepository,
                               PlatformTransactionManager transactionManager,
                               ItemReader<String> batchKafkaReader,
                               ItemProcessor<String, String> templateProcessor,
                               LocalFlatFileItemWriter localFlatFileItemWriter) {
    return new StepBuilder("localFileWriteStep", jobRepository)
            .<String, String>chunk(500, transactionManager)
            .reader(batchKafkaReader)
            .processor(templateProcessor)
            .writer(localFlatFileItemWriter)
            .build();
}

If your processor output type is not String, adjust the generic types to match your project.


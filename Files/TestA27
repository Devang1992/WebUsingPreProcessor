    private JsonMergeProperties buildJoinProperties() {
        JsonMergeProperties props = new JsonMergeProperties();

        props.setMerge(JsonPointer.compile("/TDDMessage/TDDMExtended/HVP"));
        props.setMopTag(JsonPointer.compile("/TDDMessage/TDDMExtended/HVP/Mop"));
        props.setMsgTypeTag(JsonPointer.compile("/TDDMessage/TDDMessageBody/x-type"));

        props.setMopSourcePaths(Map.of(
                "FED", JsonPointer.compile("/TDDMessage/TDDMExtended/HVP/Id/UETR"),
                "BOOK", JsonPointer.compile("/TDDMessage/TDDMExtended/HVP/Id/SwiftUETR")
        ));

        props.setMsgTypeTargetPaths(Map.of(
                "pacs.008", List.of(pathTarget("/TDDMessage/TDDMessageBody/FIToFICstmrCdtTrf/CdtTrfTxInf/PmtId/UETR")),
                "pacs.004", List.of(pathTarget("/TDDMessage/TDDMessageBody/PmtRtr/TxInf/OrgnlUETR")),
                "pacs.009", List.of(pathTarget("/TDDMessage/TDDMessageBody/FICdtTrf/CdtTrfTxInf/PmtId/UETR"))
        ));

        props.setCommonTargets(List.of(
                arrayTarget(
                        "/TDDMessage/TDDQuery",
                        "Key",
                        "UETR",
                        "Value"
                )
        ));

        props.setHeaderName(HEADER_NAME);

        return props;
    }

    private JsonMergeProperties.TagUpdate pathTarget(String path) {
        JsonMergeProperties.TagUpdate update = new JsonMergeProperties.TagUpdate();
        update.setPath(JsonPointer.compile(path));
        return update;
    }

    private JsonMergeProperties.TagUpdate arrayTarget(
            String path,
            String matchKeyField,
            String matchKeyValue,
            String valueField
    ) {
        JsonMergeProperties.TagUpdate update = new JsonMergeProperties.TagUpdate();
        update.setPath(JsonPointer.compile(path));
        update.setMatchKeyField(matchKeyField);
        update.setMatchKeyValue(matchKeyValue);
        update.setValueField(valueField);
        return update;
    }

    private JsonNode json(String json) throws Exception {
        return objectMapper.readTree(json);
    }

    private void assertHeader(Headers headers, String headerName, String expectedValue) {
        Header header = headers.lastHeader(headerName);

        assertThat(header)
                .as("Expected Kafka header '%s' to be present", headerName)
                .isNotNull();

        assertThat(new String(header.value(), StandardCharsets.UTF_8))
                .isEqualTo(expectedValue);
    }

    /**
     * Test subclass only to expose protected methods.
     *
     * If your IsoMergeProcessor has constructor args, add the same constructor here
     * and call super(...).
     */
    private static class TestableIsoMergeProcessor extends IsoMergeProcessor<String> {

        void callUpdateTagAndHeader(JsonNode mergedNode, Headers headers) {
            updateTagAndHeader(mergedNode, headers);
        }

        String callResolveSourceValue(JsonNode mergedNode) {
            return resolveSourceValue(mergedNode);
        }

        void callWriteValueAtPath(JsonNode root, JsonPointer pointer, String value) {
            writeValueAtPath(root, pointer, value);
        }
    }

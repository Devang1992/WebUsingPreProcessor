    @Test
    void updateTagAndHeader_whenFedAndPacs008_shouldUseUetrAndUpdateMessageTargetCommonTargetAndHeader() throws Exception {
        JsonNode root = json("""
                {
                  "TDDMessage": {
                    "TDDMExtended": {
                      "HVP": {
                        "Mop": "FED",
                        "Id": {
                          "UETR": "FED-UETR-123",
                          "SwiftUETR": "SWIFT-UETR-999"
                        }
                      }
                    },
                    "TDDMessageBody": {
                      "x-type": "pacs.008",
                      "FIToFICstmrCdtTrf": {
                        "CdtTrfTxInf": {
                          "PmtId": {
                            "UETR": ""
                          }
                        }
                      }
                    },
                    "TDDQuery": [
                      {
                        "Key": "ABC",
                        "Value": "old"
                      },
                      {
                        "Key": "UETR",
                        "Value": "old-uetr"
                      }
                    ]
                  }
                }
                """);

        Headers headers = new RecordHeaders();

        processor.callUpdateTagAndHeader(root, headers);

        assertThat(root.at("/TDDMessage/TDDMessageBody/FIToFICstmrCdtTrf/CdtTrfTxInf/PmtId/UETR").asText())
                .isEqualTo("FED-UETR-123");

        assertThat(root.at("/TDDMessage/TDDQuery/1/Value").asText())
                .isEqualTo("FED-UETR-123");

        assertHeader(headers, HEADER_NAME, "FED-UETR-123");
    }

